# ---------------------------------------------------------------------------
# MySpace — local environment variables
#
# 1. Copy this file to `.env.local` (same folder).
# 2. Fill in the two values below from your Supabase project:
#    Supabase Dashboard → Project Settings → API
#
# `.env.local` is git-ignored and must never be committed.
# Only the public anon/publishable key belongs here.
# NEVER put a service-role / secret key in any NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project API "anon" (publishable) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# OpenRouter (SERVER-ONLY)
#
# This is a secret. Never add a NEXT_PUBLIC_ prefix, never reference it from a
# client component, and never return it from a server action or route.
# ---------------------------------------------------------------------------

# Management key required for account credits: GET /api/v1/credits
OPENROUTER_MANAGEMENT_KEY=
